# ─────────────────────────────────────────────────────────────────────────────
# Frontend (Vite) — variáveis VITE_* são PÚBLICAS e vão para o bundle.
# Copie este arquivo para `.env.local` e preencha. Nunca coloque segredos aqui.
# ─────────────────────────────────────────────────────────────────────────────

# URL pública do site (canonical, Open Graph, sitemap). Ex.: https://seudominio.com
# Na Vercel, se ficar vazio, usa automaticamente o domínio de produção do projeto.
VITE_SITE_URL=

# Supabase — Project Settings → API. A chave "publishable" (ou a anon legada) é
# segura para o navegador porque o acesso é controlado por Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Usuário do GitHub exibido no portfólio.
VITE_GITHUB_USERNAME=erickmoura012

# ─────────────────────────────────────────────────────────────────────────────
# Scripts locais / CI (NÃO são expostos ao navegador)
# ─────────────────────────────────────────────────────────────────────────────

# Opcional: token do GitHub somente leitura (dados públicos). Usado por
# `npm run sync:github` para incluir o calendário de contribuições (GraphQL).
GITHUB_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Segredos das Edge Functions — configure com `supabase secrets set`, nunca aqui.
# Veja supabase/functions/.env.example
# ─────────────────────────────────────────────────────────────────────────────
