# ─────────────────────────────────────────────────────────────────────────────
# Segredos das Edge Functions. NUNCA versione valores reais.
#
# Produção:  npx supabase secrets set NOME=valor   (ou --env-file supabase/functions/.env)
# Local:     copie para supabase/functions/.env e rode `npx supabase functions serve`
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente pela
# plataforma — não os defina aqui.
# ─────────────────────────────────────────────────────────────────────────────

# [contact, github-sync] OBRIGATÓRIO em produção. Origens autorizadas a chamar as
# funções, separadas por vírgula, sem barra final (ex.: https://seudominio.com).
# Vazio = apenas http://localhost e http://127.0.0.1 são aceitos.
ALLOWED_ORIGINS=

# [contact] Recomendado. Texto aleatório longo usado para gerar o hash do IP no
# rate limiting (ex.: saída de `openssl rand -hex 32`).
RATE_LIMIT_SALT=

# [contact] Opcional — envio de e-mail pelo Resend (https://resend.com).
# Sem RESEND_API_KEY e CONTACT_TO_EMAIL, as mensagens ficam apenas no painel.
RESEND_API_KEY=
# Endereço que recebe as mensagens do formulário.
CONTACT_TO_EMAIL=
# Remetente verificado no Resend, no formato "Nome <email@dominio>".
# Vazio = remetente de testes do Resend (entrega só para o dono da conta).
CONTACT_FROM_EMAIL=

# [github-sync] Opcional. Token do GitHub somente leitura (dados públicos).
# Habilita o calendário de contribuições e eleva o limite de requisições.
GITHUB_TOKEN=
# [github-sync] Opcional. Padrão: erickmoura012.
GITHUB_USERNAME=

# [github-sync] Opcional. Segredo para agendamentos chamarem a função com o
# cabeçalho `x-cron-secret` (ex.: pg_cron + pg_net ou um cron externo).
CRON_SECRET=
